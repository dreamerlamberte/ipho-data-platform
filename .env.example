# Copy to .env and adjust. Never commit .env.

# Keyed-hash secret for pseudonymizing patient IDs at ingestion.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SALT=change-me

# Postgres source replica (docker compose) — or the real Supabase connection
# string when running against production (read-only role recommended).
SOURCE_PG_DSN=postgresql://ipho:ipho@localhost:5433/ipho_source

LAKE_PATH=data/lake
WAREHOUSE_PATH=data/warehouse/ipho.duckdb
